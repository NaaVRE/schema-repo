{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naavre.net/schemas/common/dependency.json",
  "title": "dependency",
  "description": "Schema for a cell dependency",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "examples": [
        "pandas",
        "numpy"
      ]
    },
    "module": {
      "type": "string",
      "examples": [
        "pandas",
        "numpy"
      ]
    },
    "asname": {
      "type": "string",
      "examples": [
        "pd",
        "np"
      ]
    }
  },
  "required": [
    "name"
  ]
}