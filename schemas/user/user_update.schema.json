{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naavre.net/schemas/user/user_update.schema.json",
  "title": "UserUpdate",
  "description": "Request body for updating an existing user (all fields optional)",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "New email address"
    },
    "full_name": {
      "type": "string",
      "maxLength": 200,
      "description": "New full display name"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "description": "New password (will be hashed before storage)"
    },
    "is_active": {
      "type": "boolean",
      "description": "Update active status"
    }
  },
  "minProperties": 1
}
