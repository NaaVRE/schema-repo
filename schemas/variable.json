{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naavre.net/schemas/common/variable.json",
  "title": "variable",
  "description": "Reusable schema for a all variables.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "examples": [
        "input1",
        "output1",
        "param_a",
        "secret_1"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "float",
        "int",
        "list",
        "string"
      ]
    },
    "value": {
      "type": "string",
      "examples": [
        "42",
        "1.1",
        "[1, 2, 3]",
        "hello world"
      ]
    },
    "node_id": {
      "type": "string",
      "examples": [
        "a24c2f55-1ac8-44ba-9ef9-e841bac5389a"
      ]
    }
  },
  "required": [
    "name",
    "type"
  ]
}
